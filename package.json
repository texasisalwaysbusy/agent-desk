{
  "name": "agent-desk",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "taskctl": "./cli/taskctl.mjs",
    "agentdesk": "./cli/agentdesk.mjs"
  },
  "scripts": {
    "codex": "node scripts/codex-injector.mjs --launch --watch --open --cdp-pipe",
    "app:prepare": "npm run build:web && node scripts/prepare-tauri-app.mjs",
    "app:dev": "npm run app:prepare && tauri dev",
    "app:build": "npm run app:build:windows",
    "app:build:windows": "npm run app:prepare -- --target x86_64-pc-windows-msvc && tauri build --target x86_64-pc-windows-msvc --bundles nsis --no-sign --ci --config src-tauri/tauri.windows.conf.json",
    "app:verify-packaged-taskctl": "node scripts/verify-packaged-taskctl.mjs",
    "tauri": "tauri",
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/index.mjs --dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "start": "node server/index.mjs",
    "taskctl": "node cli/taskctl.mjs",
    "migrate:local": "node scripts/migrate-local-data.mjs",
    "test": "node scripts/test-node.mjs && npm run test:components",
    "test:components": "vitest run --dir web/src web/src/components/MarkdownDocument.test.tsx web/src/components/ApprovalCenter.test.tsx web/src/components/DashboardView.test.tsx --environment jsdom",
    "check": "npm run typecheck && npm run build && npm test",
    "agentdesk": "node cli/agentdesk.mjs"
  },
  "dependencies": {
    "dhtmlx-gantt": "^10.0.0",
    "dompurify": "^3.4.13",
    "js-yaml": "4.3.1",
    "mdast-util-definitions": "^6.0.0",
    "mermaid": "^11.16.1",
    "micromark-util-decode-string": "^2.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "smol-toml": "^1.8.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/js-yaml": "4.0.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^27.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "description": "Local workspace for agent tasks, collaboration and human review",
  "license": "SEE LICENSE IN LICENSE"
}
